[Unit]
Description=Deploy a newly published portfolio image
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/portfolio-update
StateDirectory=portfolio-update
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
