#!/usr/bin/env sh
set -eu

repository="${PORTFOLIO_IMAGE_REPOSITORY:-docker.io/rezabarzakhi/portfolio}"
registry_mirror="${PORTFOLIO_REGISTRY_MIRROR:-https://docker.arvancloud.ir}"
env_file=/opt/stacks/portfolio/.env
deployed_release_file=/var/lib/portfolio-update/deployed-release
failed_release_file=/var/lib/portfolio-update/failed-release

if ! printf '%s\n' "$repository" | grep -Eq '^docker\.io/[a-z0-9][a-z0-9_.-]*/portfolio$'; then
  echo "Invalid portfolio image repository: $repository"
  exit 1
fi

if ! printf '%s\n' "$registry_mirror" | grep -Eq '^https://[a-z0-9][a-z0-9.-]+$'; then
  echo "Invalid registry mirror: $registry_mirror"
  exit 1
fi

if ! command -v curl >/dev/null 2>&1; then
  echo "Required command is missing: curl"
  exit 1
fi

repository_path="${repository#docker.io/}"
deployed_release=0
if [ -f "$deployed_release_file" ]; then
  saved_release="$(cat "$deployed_release_file")"
  if printf '%s\n' "$saved_release" | grep -Eq '^[0-9]+$'; then
    deployed_release="$saved_release"
  fi
fi

release=""
candidate_release=$((deployed_release + 1))
scan_end=$((candidate_release + 24))
while [ "$candidate_release" -le "$scan_end" ]; do
  status="$(curl --head --silent --output /dev/null --write-out '%{http_code}' \
    --connect-timeout 10 --max-time 20 \
    --header 'Accept: application/vnd.docker.distribution.manifest.v2+json' \
    "$registry_mirror/v2/$repository_path/manifests/release-$candidate_release" || true)"
  if [ "$status" = "200" ]; then
    release="$candidate_release"
  fi
  candidate_release=$((candidate_release + 1))
done

if ! printf '%s\n' "$release" | grep -Eq '^[0-9]+$'; then
  echo "No newer numbered portfolio release is available."
  exit 0
fi

if [ -f "$failed_release_file" ] && [ "$(cat "$failed_release_file")" = "$release" ]; then
  echo "Skipping release $release because its previous deployment failed."
  exit 0
fi

candidate="$repository:release-$release"
echo "Pulling $candidate..."
docker pull "$candidate"

digest="$(
  docker image inspect --format '{{range .RepoDigests}}{{println .}}{{end}}' "$candidate" |
    sed -n 's/.*@\(sha256:[0-9a-f]\{64\}\)$/\1/p' |
    head -n 1
)"
revision="$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$candidate")"

if ! printf '%s\n' "$digest" | grep -Eq '^sha256:[0-9a-f]{64}$'; then
  echo "The published image has no valid repository digest."
  exit 1
fi

if ! printf '%s\n' "$revision" | grep -Eq '^[0-9a-f]{40}$'; then
  echo "The published image has no valid source revision label."
  exit 1
fi

image="$repository@$digest"
current="$(sed -n 's/^APP_IMAGE=//p' "$env_file" | tail -n 1)"

if [ "$current" = "$image" ]; then
  echo "Portfolio is already current at revision $revision."
  printf '%s\n' "$release" > "$deployed_release_file"
  rm -f "$failed_release_file"
  exit 0
fi

if /usr/local/sbin/portfolio-ci-deploy "$image"; then
  printf '%s\n' "$release" > "$deployed_release_file"
  rm -f "$failed_release_file"
  echo "Portfolio updated to release $release at revision $revision."
  exit 0
fi

printf '%s\n' "$release" > "$failed_release_file"
echo "Recorded failed portfolio release $release at revision $revision."
exit 1
